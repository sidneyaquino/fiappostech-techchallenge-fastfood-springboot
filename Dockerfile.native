FROM docker.io/bellsoft/liberica-native-image-kit-container:jdk-24-nik-24-musl AS builder
# FROM ghcr.io/graalvm/native-image-community:24-muslib AS builder
WORKDIR /tmp
ADD .mvn/ .mvn
ADD mvnw pom.xml ./
RUN --mount=type=cache,target=/root/.m2 \
   ./mvnw dependency:go-offline
ADD src/ src
RUN --mount=type=cache,target=/root/.m2 \
   ./mvnw -Pnative package native:compile-no-fork \
   -Dmanven.test.skip=true -DskipTests -Djacoco.skip

FROM docker.io/bellsoft/alpaquita-linux-base:stream-musl AS runner
# FROM docker.io/library/busybox:musl AS runner
COPY --chown=755 --from=builder /tmp/target/fastfood /app/app
RUN adduser --disabled-password -u 10001 nonroot \
   && echo "nonroot:x:10001:10001:App User:/:/sbin/nologin" > /etc/minimal-passwd
USER nonroot
SHELL ["/bin/sh", "-c"]
CMD [ "/app/app", "-Dserver.port=${PORT:-8080}", \
   "-Dspring.backgroundpreinitializer.ignore=true", \
   "-Dfile.encoding=UTF-8" \
]